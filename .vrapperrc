set gvimpath=/Users/eduardo.hernandez/scoop/apps/vim/current/gvim
set number
set ignorecase
set smartcase
set incsearch
set hlsearch
set scrolloff=2
set expandtab
set tabstop=2
set softtabstop=2
set shiftwidth=2
set textwidth=100

set startnormalmode
set autoindent
set cursorline
set clipboard=unnamed

" Map leader to Space
let mapleader="<Space>"
"nnoremap <Leader>, ,
"nnoremap \ ,
"xnoremap \ ,
"onoremap \ ,

:subwordmappings

nnoremap <Leader>q :q<CR>
nnoremap <Leader>x :x<CR>
nnoremap <Leader>l :ls<CR>

"nnoremap <Leader>s :s///g<Left><Left><Left>
"vnoremap <Leader>s :s///g<Left><Left><Left>

nmap <C-l> :nohlsearch<CR>

nnoremap gt <C-w>gt
nnoremap gT <C-w>gT

" Insert empty line above current line
nnoremap <Leader>O m`O<Esc>``
" and below current line
nnoremap <Leader>o m`o<Esc>``

" Paste from yank register
nnoremap <Leader>p "0p
nnoremap <Leader>P "0P
vnoremap <Leader>p "0p
vnoremap <Leader>P "0P

" Don't store the deleted text in any register
nnoremap <Leader>d "_d
vnoremap <Leader>d "_d

" Makes visual paste replace the selection without overwriting the unnamed register
xnoremap p "_dP

nnoremap * *N
nnoremap # #N

"Bugfix {num}J
nnoremap 2J JJ
nnoremap 3J JJJ
nnoremap 4J JJJJ
nnoremap 5J JJJJJ

" Jump to the previous unmatched }
nnoremap [} ?}<CR>:noh<CR>
"onoremap [} ?}<CR>:noh<CR>

" Jump to the previous unmatched {
nnoremap ]{ /\{<CR>:noh<CR>
"onoremap ]{ /\{<CR>:noh<CR>

eclipseaction nextMember org.eclipse.jdt.ui.edit.text.java.goto.next.member
nnoremap ]] :nextMember<CR>

eclipseaction prevMember org.eclipse.jdt.ui.edit.text.java.goto.previous.member
nnoremap [[ :prevMember<CR>

eclipseuiaction nextEditor org.eclipse.ui.navigate.nextTab
nnoremap ]b :nextEditor<CR>
nnoremap <S-l> gt

eclipseuiaction prevEditor org.eclipse.ui.navigate.previousTab
noremap [b :prevEditor<CR>
nnoremap <S-h> gT

eclipseuiaction nextView org.eclipse.ui.window.nextView
"nnoremap ]v :nextView<CR>
nnoremap <Leader>v :nextView<CR>

eclipseuiaction prevView org.eclipse.ui.window.previousView
"noremap [v :prevView<CR>

eclipseuiaction nextPerspective org.eclipse.ui.window.nextPerspective
"nnoremap ]p :nextPerspective<CR>
nnoremap <Leader>p :nextPerspective<CR>

eclipseuiaction prevPerspective org.eclipse.ui.window.previousPerspective
"noremap [p :prevPerspective<CR>

eclipseaction nextSearchEntry org.eclipse.search.ui.globalNextSearchEntry
nnoremap ]n :nextSearchEntry<CR>

eclipseaction prevSearchEntry org.eclipse.search.ui.globalPreviousSearchEntry
nnoremap [n :prevSearchEntry<CR>

eclipseaction next org.eclipse.ui.navigate.next
nnoremap ]d :next<CR>

eclipseaction previous org.eclipse.ui.navigate.previous 
nnoremap [d :previous<CR>

eclipseaction next org.eclipse.ui.navigate.next
nnoremap ]e :next<CR>

eclipseaction previous org.eclipse.ui.navigate.previous 
nnoremap [e :previous<CR>

eclipseuiaction tooltip org.eclipse.ui.edit.text.showInformation
nnoremap K :tooltip<CR>
nnoremap gh :tooltip<CR>

eclipseuiaction quickSwitchEditor org.eclipse.ui.window.openEditorDropDown
"nnoremap <Leader>l :quickSwitchEditor<CR>
nnoremap <Leader>, :quickSwitchEditor<CR>
nnoremap <Leader>fb :quickSwitchEditor<CR>

eclipseuiaction openResource org.eclipse.ui.navigate.openResource
nnoremap <Leader><Leader> :openResource<CR>
nnoremap <Leader>ff :openResource<CR>

eclipseuiaction openType org.eclipse.jdt.ui.navigate.open.type
nnoremap <Leader>fF :openType<CR>

eclipseuiaction newWizard org.eclipse.ui.newWizard
nnoremap <Leader>fn :newWizard<CR>

eclipseuiaction switchEditor org.eclipse.ui.window.switchToEditor
nnoremap <Leader>fB :switchEditor<CR>

eclipseuiaction showIn org.eclipse.ui.navigate.showInQuickMenu
nnoremap <Leader>fe :showIn<CR>

eclipseaction term org.eclipse.ui.views.showView(org.eclipse.ui.views.showView.viewId=org.eclipse.terminal.view.ui.TerminalsView)
nnoremap <Leader>ft :term<CR>

eclipseaction projectExplorer org.eclipse.ui.views.showView(org.eclipse.ui.views.showView.viewId=org.eclipse.ui.navigator.ProjectExplorer)
nnoremap <Leader>E :projectExplorer<CR>

eclipseaction textSearch org.eclipse.search.ui.openFileSearchPage
eclipseaction searchDialog org.eclipse.search.ui.openSearchDialog
nnoremap <Leader>/ :textSearch<CR>
vnoremap <Leader>/ :textSearch<CR>
nnoremap <Leader>sg :textSearch<CR>

eclipseaction findReplace org.eclipse.ui.edit.findReplace
nnoremap <Leader>sr :findReplace<CR>
vnoremap <Leader>sr :findReplace<CR>

eclipseaction performTextSearch org.eclipse.search.ui.performTextSearchWorkspace
nnoremap <Leader>sw :performTextSearch<CR>
vnoremap <Leader>sw :performTextSearch<CR>

eclipseuiaction outline org.eclipse.jdt.ui.edit.text.java.show.outline
nnoremap <Leader>ss :outline<CR>
nnoremap gs :outline<CR>

eclipseaction contentOutline org.eclipse.ui.views.showView(org.eclipse.ui.views.showView.viewId=org.eclipse.ui.views.ContentOutline)
nnoremap <Leader>sS :contentOutline<CR>

eclipseuiaction keyAssist org.eclipse.ui.window.showKeyAssist
nnoremap <Leader>sk :keyAssist<CR>

eclipseuiaction quickAccess org.eclipse.ui.window.quickAccess
nnoremap <Leader>sc :quickAccess<CR>

eclipseuiaction quickFix org.eclipse.jdt.ui.edit.text.java.correction.assist.proposals
nnoremap <Leader>ca :quickFix<CR>
nnoremap <Leader>cA :quickFix<CR>
nnoremap g. :quickFix<CR>

"eclipseaction format org.eclipse.jdt.ui.edit.text.java.quick.format
"vmap <Leader>q :format<CR>
"nnoremap <Leader>q :fm<CR>
"vnoremap <Leader>q :fm<CR>
nnoremap <Leader>cf :fm<CR>
vnoremap <Leader>cf :fm<CR>

nnoremap <Leader>cr gR 

"nnoremap <Leader>cd gR 
nnoremap <Leader>cd :tooltip<CR> 

eclipseaction imports org.eclipse.jdt.ui.edit.text.java.organize.imports
nnoremap <Leader>co :imports<CR>

eclipseaction references org.eclipse.jdt.ui.edit.text.java.search.references.in.workspace
nnoremap gr :references<CR>

eclipseuiaction typeHierarchy org.eclipse.jdt.ui.edit.text.java.open.hierarchy
nnoremap gI :typeHierarchy<CR>

eclipseaction paramHints org.eclipse.ui.edit.text.contentAssist.contextInformation
nnoremap gK :paramHints<CR>

nnoremap <Leader>bb <C-6>

eclipseaction close org.eclipse.ui.file.close
nnoremap <Leader>bd :close<CR>
"nnoremap <Leader>bd <C-w>q

eclipseaction closeOthers org.eclipse.ui.file.closeOthers
nnoremap <Leader>bo :closeOthers<CR>

eclipseaction pinEditor org.eclipse.ui.window.pinEditor
nnoremap <Leader>bp :pinEditor<CR>
nnoremap <Leader>bP :pinEditor<CR>

eclipseaction closeAll org.eclipse.ui.file.closeAll
nnoremap <Leader>bE :closeAll<CR>

eclipseaction gitExplorer org.eclipse.ui.perspectives.showPerspective(org.eclipse.ui.perspectives.showPerspective.perspectiveId=org.eclipse.team.ui.GitRepositoryExploring)
nnoremap <Leader>gg :gitExplorer<CR>

eclipseaction teamSync org.eclipse.ui.perspectives.showPerspective(org.eclipse.ui.perspectives.showPerspective.perspectiveId=org.eclipse.team.ui.TeamSynchronizingPerspective)
nnoremap <Leader>gs :teamSync<CR>

eclipseaction compareWithHead org.eclipse.egit.ui.team.CompareWithHead
nnoremap <Leader>gd :compareWithHead<CR>

eclipseaction showHistory org.eclipse.egit.ui.team.ShowHistory
nnoremap <Leader>gl :showHistory<CR>

eclipseaction compareWithHead org.eclipse.egit.ui.team.CompareWithHead
nnoremap <Leader>gd :compareWithHead<CR>

eclipseaction replaceWithHead org.eclipse.egit.ui.team.ReplaceWithHead
nnoremap <Leader>gR :replaceWithHead<CR>

eclipseaction maximize org.eclipse.ui.window.maximizePart
nnoremap <Leader>wm :maximize<CR>

eclipseaction wordWrap org.eclipse.ui.edit.text.toggleWordWrap
nnoremap <Leader>uw :wordWrap<CR>

eclipseaction fullscreen org.eclipse.ui.window.fullscreenmode
nnoremap <Leader>uz :fullscreen<CR>

" Sneak
nmap s <Plug>(sneak_s)
nmap S <Plug>(sneak_S)
nmap ; <Plug>(sneak-next)
"nmap \ <Plug>(sneak-prev)
nmap , <Plug>(sneak-prev)
vmap s <Plug>(sneak_s)
vmap Z <Plug>(sneak_S)
vmap ; <Plug>(sneak-next)
"vmap \ <Plug>(sneak-prev)
vmap , <Plug>(sneak-prev)
nmap f <Plug>(sneak_f)
nmap F <Plug>(sneak_F)
nmap t <Plug>(sneak_t)
nmap T <Plug>(sneak_T)
vmap f <Plug>(sneak_f)
vmap F <Plug>(sneak_F)
vmap t <Plug>(sneak_t)
vmap T <Plug>(sneak_T)
omap z <Plug>(sneak_s)
omap Z <Plug>(sneak_S)

"Eclipse key bindings
"C-/ Show View Terminal
"]c Select Next Change (Compare)
"[c Select Prev Change (Compare)
