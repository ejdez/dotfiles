set gvimpath=/Users/eduardo.hernandez/scoop/apps/vim/current/gvim
set number
set ignorecase
set smartcase
set incsearch
set hlsearch
set scrolloff=2
set expandtab
set tabstop=2
set softtabstop=2
set shiftwidth=2
set textwidth=100

set startnormalmode
set autoindent
set cursorline
set clipboard=unnamed

" Map leader to Space
let mapleader="<Space>"
"nnoremap <Leader>, ,
"nnoremap \ ,
"xnoremap \ ,
"onoremap \ ,

:subwordmappings

nnoremap <Leader>q :q<CR>
nnoremap <Leader>x :x<CR>
"nnoremap <Leader>l :ls<CR>

nnoremap <Leader>s :s///g<Left><Left><Left>
vnoremap <Leader>s :s///g<Left><Left><Left>

nmap <C-l> :nohlsearch<CR>

nnoremap gt <C-w>gt
nnoremap gT <C-w>gT

" Insert empty line above current line
"nnoremap <Leader>O O<Esc>j
nnoremap <Leader>O m`O<Esc>``
" and below current line
nnoremap <M-o> m`o<Esc>``

" Paste from yank register
nnoremap <Leader>p "0p
nnoremap <Leader>P "0P
vnoremap <Leader>p "0p
vnoremap <Leader>P "0P

" Don't store the deleted text in any register
nnoremap <Leader>d "_d
vnoremap <Leader>d "_d

" Makes visual paste replace the selection without overwriting the unnamed register
xnoremap p "_dP

nnoremap * *N
nnoremap # #N

"Bugfix {num}J
nnoremap 2J JJ
nnoremap 3J JJJ
nnoremap 4J JJJJ
nnoremap 5J JJJJJ

" Move to the next capital letter"
"nnoremap ]U /[A-Z]<Return>:noh<CR>
"nnoremap [U ?[A-Z]<Return>:noh<CR>

" Jump to the previous unmatched }
nnoremap [} ?}<CR>:noh<CR>
"onoremap [} ?}<CR>:noh<CR>

" Jump to the previous unmatched {
nnoremap ]{ /\{<CR>:noh<CR>
"onoremap ]{ /\{<CR>:noh<CR>

eclipseaction NextMember org.eclipse.jdt.ui.edit.text.java.goto.next.member
nnoremap ]] :NextMember<CR>

eclipseaction PreviousMember org.eclipse.jdt.ui.edit.text.java.goto.previous.member
nnoremap [[ :PreviousMember<CR>

eclipseuiaction QuickSwitchEditor org.eclipse.ui.window.openEditorDropDown
"nnoremap gb :QuickSwitchEditor<CR>
nnoremap <Leader>l :QuickSwitchEditor<CR>

"eclipseaction QuickFormat org.eclipse.jdt.ui.edit.text.java.quick.format
"vmap <Leader>q :QuickFormat<CR>
nnoremap <Leader>q :fm<CR>
vnoremap <Leader>q :fm<CR>

eclipseuiaction QuickTypeHierarchy org.eclipse.jdt.ui.edit.text.java.open.hierarchy
nnoremap <Leader>t :QuickTypeHierarchy<CR>

eclipseuiaction ShowOutline org.eclipse.jdt.ui.edit.text.java.show.outline
nnoremap <Leader>o :ShowOutline<CR>

"nnoremap <Leader>rn :eclipsecmd org.eclipse.jdt.ui.edit.text.java.rename.element<CR>

" Sneak
nmap s <Plug>(sneak_s)
nmap S <Plug>(sneak_S)
nmap ; <Plug>(sneak-next)
"nmap \ <Plug>(sneak-prev)
nmap , <Plug>(sneak-prev)
vmap s <Plug>(sneak_s)
vmap Z <Plug>(sneak_S)
vmap ; <Plug>(sneak-next)
"vmap \ <Plug>(sneak-prev)
vmap , <Plug>(sneak-prev)
nmap f <Plug>(sneak_f)
nmap F <Plug>(sneak_F)
nmap t <Plug>(sneak_t)
nmap T <Plug>(sneak_T)
vmap f <Plug>(sneak_f)
vmap F <Plug>(sneak_F)
vmap t <Plug>(sneak_t)
vmap T <Plug>(sneak_T)
omap z <Plug>(sneak_s)
omap Z <Plug>(sneak_S)

